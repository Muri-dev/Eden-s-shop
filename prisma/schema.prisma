generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  role          String    @default("CUSTOMER") // CUSTOMER
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      Wishlist?
  reviews       Review[]
  couponUsages  CouponUsage[]

  @@index([email])
}

model AdminUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("ADMIN") // SUPER_ADMIN, ADMIN, STAFF
  avatar        String?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]

  @@index([email])
}

model Address {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @default("SHIPPING") // SHIPPING, BILLING
  fullName      String
  phone         String
  streetAddress String
  apartment     String?
  city          String
  state         String?
  postalCode    String?
  country       String    @default("Kenya")
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// ==========================================
// 2. PRODUCT CATALOG
// ==========================================

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  description   String?
  image         String?
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subcategories Category[] @relation("SubCategories")
  isFeatured    Boolean    @default(false)
  order         Int        @default(0)
  isVisible     Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products      Product[]

  @@index([slug])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  website     String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id                String                 @id @default(uuid())
  name              String
  slug              String                 @unique
  sku               String                 @unique
  description       String
  shortDescription  String?
  categoryId        String
  category          Category               @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?                 @relation(fields: [brandId], references: [id])
  price             Float
  discountPrice     Float?
  costPrice         Float?
  stock             Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  isFeatured        Boolean                @default(false)
  isNewArrival      Boolean                @default(false)
  isBestSeller      Boolean                @default(false)
  isFlashSale       Boolean                @default(false)
  flashSalePrice    Float?
  status            String                 @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  seoTitle          String?
  seoDescription    String?
  tags              String?                // Comma-separated or JSON string
  weight            String?
  dimensions        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  images            ProductImage[]
  variants          ProductVariant[]
  specifications    ProductSpecification[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  inventoryLogs     InventoryMovement[]
  flashSaleProducts FlashSaleProduct[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
}

model ProductVariant {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String              @unique
  name           String
  size           String?
  color          String?
  colorCode      String?
  price          Float
  stock          Int                 @default(0)
  image          String?
  attributesJson String?             // Custom attributes key-value JSON
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  inventoryLogs  InventoryMovement[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String?
  order       Int      @default(0)
  isThumbnail Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  group     String?
  order     Int     @default(0)

  @@index([productId])
}

// ==========================================
// 3. CART & WISHLIST
// ==========================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     WishlistItem[]
}

model WishlistItem {
  id         String          @id @default(uuid())
  wishlistId String
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([wishlistId])
  @@index([productId])
}

// ==========================================
// 4. ORDERS & CHECKOUT
// ==========================================

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail       String
  customerName        String
  customerPhone       String
  shippingAddressJson String        // Serialized JSON with address snapshot
  billingAddressJson  String?
  shippingMethodId    String?
  shippingMethodName  String?
  shippingCost        Float         @default(0.0)
  subtotal            Float
  discountAmount      Float         @default(0.0)
  taxAmount           Float         @default(0.0)
  grandTotal          Float
  currency            String        @default("KES")
  status              String        @default("PENDING") 
  // Statuses: PENDING, PAYMENT_PENDING, PAID, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REFUNDED
  paymentStatus       String        @default("PENDING") 
  // Statuses: PENDING, SUCCESSFUL, FAILED, REFUNDED, PARTIALLY_REFUNDED
  notes               String?
  cancelReason        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]
  payments            Payment[]
  couponUsages        CouponUsage[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  variantName        String?
  sku                String
  priceAtPurchase    Float           // Strict historical snapshot
  discountAtPurchase Float           @default(0.0)
  quantity           Int
  subtotal           Float
  imageAtPurchase    String?
  createdAt          DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

// ==========================================
// 5. PAYMENTS (PAYSTACK + M-PESA)
// ==========================================

model Payment {
  id                   String         @id @default(uuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference            String         @unique
  amount               Float
  currency             String         @default("KES")
  channel              String?        // mobile_money, card, bank, ussd
  status               String         @default("PENDING") // PENDING, SUCCESSFUL, FAILED, ABANDONED, REFUNDED
  provider             String         @default("PAYSTACK")
  providerResponseJson String?        // Raw response snapshot
  paidAt               DateTime?
  customerPhone        String?
  customerEmail        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  events               PaymentEvent[]

  @@index([orderId])
  @@index([reference])
  @@index([status])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType   String   // charge.success, charge.failed, etc.
  reference   String
  payloadJson String   // Full webhook payload for audit and idempotency
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([reference])
}

// ==========================================
// 6. PROMOTIONS, COUPONS, FLASH SALES
// ==========================================

model Coupon {
  id               String        @id @default(uuid())
  code             String        @unique
  description      String?
  discountType     String        @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue    Float
  minOrderValue    Float?        @default(0.0)
  maxDiscountValue Float?
  startDate        DateTime?
  endDate          DateTime?
  usageLimit       Int?
  timesUsed        Int           @default(0)
  perCustomerLimit Int?          @default(1)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  usages           CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model Discount {
  id             String    @id @default(uuid())
  name           String
  type           String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  value          Float
  targetType     String    @default("ALL") // ALL, PRODUCT, CATEGORY
  targetId       String?
  minQuantity    Int?      @default(1)
  minOrderAmount Float?    @default(0.0)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FlashSale {
  id          String             @id @default(uuid())
  title       String
  description String?
  bannerImage String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  products    FlashSaleProduct[]
}

model FlashSaleProduct {
  id               String    @id @default(uuid())
  flashSaleId      String
  flashSale        FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  salePrice        Float
  maxQuantity      Int       @default(100)
  soldQuantity     Int       @default(0)
  perCustomerLimit Int       @default(2)

  @@index([flashSaleId])
  @@index([productId])
}

model Promotion {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  bannerImage String?
  linkUrl     String?
  badgeText   String?
  type        String    @default("HERO") // HERO, BANNER, PROMO_CARD
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// 7. REVIEWS & ENGAGEMENT
// ==========================================

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @default(5)
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  status             String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

// ==========================================
// 8. INVENTORY LOGGING
// ==========================================

model InventoryMovement {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type           String          // IN, OUT, ADJUSTMENT, ORDER_RESERVED, ORDER_CONFIRMED, ORDER_CANCELLED
  quantity       Int
  remainingStock Int
  reason         String?
  referenceId    String?         // Order ID or Purchase Order ID
  performedBy    String?         // Admin user or System
  createdAt      DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

// ==========================================
// 9. SYSTEM, CMS & AUDITING
// ==========================================

model ShippingMethod {
  id              String   @id @default(uuid())
  name            String
  description     String?
  cost            Float    @default(0.0)
  estimatedDays   String?
  minOrderForFree Float?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("GENERAL") // GENERAL, HERO, FOOTER, POLICIES, CONTACT, SOCIAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Banner {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  targetUrl  String   @default("/shop")
  buttonText String?  @default("Shop Now")
  position   String   @default("HOME_TOP") // HOME_TOP, HOME_MIDDLE, POPUP
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id          String     @id @default(uuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail  String?
  action      String     // CREATE_PRODUCT, UPDATE_ORDER, CHANGE_STATUS, etc.
  entity      String     // PRODUCT, ORDER, CATEGORY, etc.
  entityId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entity])
}
